<UserControl x:Class="DoAnNhom.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAnNhom"
        mc:Ignorable="d">
    <Grid>
    
        <Grid.Background>
            <ImageBrush ImageSource="/images/backgr.png"
                        Stretch="UniformToFill"/>
            
        </Grid.Background>

        <Border Width="380"
                Padding="35"
                CornerRadius="20"
                BorderBrush="#55D4AF37"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Background>
                <SolidColorBrush Color="Black" Opacity="0.55"/>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="35"
                                  ShadowDepth="0"
                                  Opacity="0.7"
                                  Color="Black"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock HorizontalAlignment="Center"
                           FontSize="28"
                           FontFamily="Cambria"
                           FontWeight="Bold"
                           Margin="0,0,0,5">
                    <Run Text="WELCOME" Foreground="White"/>
                    <Run Text="BACK" Foreground="#D4AF37"/>
                </TextBlock>

                <TextBlock Text="Đăng nhập để tiếp tục hành trình của bạn"
                           Foreground="#CCCCCC"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Border CornerRadius="8"
        Background="Black"
        BorderBrush="#55D4AF37"
        BorderThickness="1"
        Height="45"
        Margin="0,0,0,15">
                    <Grid>

                        <TextBox x:Name="txtUsername"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 CaretBrush="White"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 Padding="15,0"
                 GotFocus="txtUsername_GotFocus"
                 LostFocus="txtUsername_LostFocus"/>

                        <TextBlock x:Name="lblUsernamePlaceholder" 
                   Text="Tên đăng nhập" 
                   Foreground="#88FFFFFF" 
                   VerticalAlignment="Center" 
                   Margin="15,0" 
                   FontSize="14" 
                   IsHitTestVisible="False" 
                   Visibility="Visible"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Height="45" Margin="0,0,0,30">
                    <Grid>
                        <TextBlock Text="🔒" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="10,0" FontSize="16" IsHitTestVisible="False"/>

                        <PasswordBox x:Name="txtPassword" 
                     Background="Transparent" 
                     Foreground="White" 
                     BorderThickness="0" 
                     VerticalContentAlignment="Center" 
                     Padding="35,0" 
                     FontSize="14"
                     GotFocus="txtPassword_GotFocus"
                     LostFocus="txtPassword_LostFocus"/>

                        <TextBlock x:Name="lblPasswordPlaceholder" 
                   Text="Mật khẩu" 
                   Foreground="#66FFFFFF" 
                   VerticalAlignment="Center" 
                   Margin="35,0" 
                   FontSize="14" 
                   IsHitTestVisible="False" 
                   Visibility="Visible"/>
                    </Grid>
                </Border>

                <Button Height="45"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="ĐĂNG NHẬP"
                        Click="Button_DangNhap">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F6E27A" Offset="0"/>
                                        <GradientStop Color="#D4AF37" Offset="0.5"/>
                                        <GradientStop Color="#A67C00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>

        <Button Content="✕"
                Width="35" Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,15,15,0"
                Background="Transparent"
                Foreground="White"
                BorderThickness="0"
                FontSize="16"
                Cursor="Hand"
                Click="BtnClose_Click"/>
    </Grid>
</UserControl>
