<Page x:Class="DoAnNhom.SuaTaiKhoan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111111">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="40">

            <Border Background="#1A1A1A"
                    CornerRadius="15"
                    Padding="35"
                    BorderBrush="#33D4AF37"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock x:Name="txtTitle"
                               Text="SỬA TÀI KHOẢN"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#D4AF37"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Tên đăng nhập"
                               Foreground="White"/>
                    <TextBox x:Name="txtTenDangNhap"
                             Height="35"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <TextBlock Text="Họ tên"
                               Foreground="White"/>
                    <TextBox x:Name="txtHoTen"
                             Height="35"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <TextBlock Text="Email"
                               Foreground="White"/>
                    <TextBox x:Name="txtEmail"
                             Height="35"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <TextBlock Text="Số điện thoại"
                               Foreground="White"/>
                    <TextBox x:Name="txtSoDienThoai"
                             Height="35"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <TextBlock Text="Địa chỉ"
                               Foreground="White"/>
                    <TextBox x:Name="txtDiaChi"
                             Height="35"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <TextBlock Text="Mật khẩu (chỉ nhập khi thêm mới)"
                               Foreground="White"/>
                    <PasswordBox x:Name="txtMatKhau"
                                 Height="35"
                                 Margin="0,5,0,15"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#333"
                                 Padding="10"/>

                    <TextBlock Text="Vai trò"
                               Foreground="White"/>
                    <ComboBox x:Name="cbVaiTro"
                              Height="35"
                              Margin="0,5,0,25"
                              Background="#2A2A2A"
                              Foreground="White"
                              BorderBrush="#333">
                        <ComboBoxItem Content="User"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <Button x:Name="btnAction"
                            Content="CẬP NHẬT"
                            Height="45"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="Black"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnAction_Click">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F6E27A" Offset="0"/>
                                <GradientStop Color="#D4AF37" Offset="0.5"/>
                                <GradientStop Color="#A67C00" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>
</Page>