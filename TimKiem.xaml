<Page x:Class="DoAnNhom.Views.TimKiem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tìm kiếm"
      Background="#1A1A1A">

    <Page.Resources>
        <!-- Gold Brush -->
        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5D77A" Offset="0"/>
            <GradientStop Color="#C9A227" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="LuxInput" TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CaretBrush" Value="#F5D77A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="10,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#F5D77A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LuxCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LuxLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LuxSearchBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{StaticResource GoldBrush}"
                                CornerRadius="8"
                                Padding="16,0">
                            <TextBlock Text="🔍  Tìm kiếm"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#111111"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FBE5A0" Offset="0"/>
                                            <GradientStop Color="#D4AF37" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#C9A227" Offset="0"/>
                                            <GradientStop Color="#A8871E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== BỘ LỌC TÌM KIẾM (Full width) ===== -->
        <Border Grid.Row="0"
                Background="#141414"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="40,22,40,20">

            <StackPanel>
                <!-- Hàng 1: Từ khóa + Nút tìm kiếm -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtTuKhoa"
                             Grid.Column="0"
                             Style="{StaticResource LuxInput}"
                             Margin="0,0,15,0"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource LuxSearchBtn}"
                            Click="BtnTimKiem_Click"/>
                </Grid>

                <!-- Hàng 2: Các bộ lọc (tự động chia đều) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Loại tin -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Loại tin" Style="{StaticResource LuxLabel}"/>
                        <ComboBox x:Name="cbLoai" Style="{StaticResource LuxCombo}">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="MuaBan"/>
                            <ComboBoxItem Content="ChoThue"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Loại BĐS -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Loại BĐS" Style="{StaticResource LuxLabel}"/>
                        <ComboBox x:Name="cbLoaiBDS" Style="{StaticResource LuxCombo}">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="NhaO"/>
                            <ComboBoxItem Content="CanHo"/>
                            <ComboBoxItem Content="Dat"/>
                            <ComboBoxItem Content="BietThu"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Giá từ -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Giá từ" Style="{StaticResource LuxLabel}"/>
                        <TextBox x:Name="txtGiaTu" Style="{StaticResource LuxInput}"/>
                    </StackPanel>

                    <!-- Giá đến -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Giá đến" Style="{StaticResource LuxLabel}"/>
                        <TextBox x:Name="txtGiaDen" Style="{StaticResource LuxInput}"/>
                    </StackPanel>

                    <!-- Diện tích từ -->
                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="Diện tích từ" Style="{StaticResource LuxLabel}"/>
                        <TextBox x:Name="txtDienTichTu" Style="{StaticResource LuxInput}"/>
                    </StackPanel>

                    <!-- Diện tích đến -->
                    <StackPanel Grid.Column="5" Margin="0,0,12,0">
                        <TextBlock Text="Diện tích đến" Style="{StaticResource LuxLabel}"/>
                        <TextBox x:Name="txtDienTichDen" Style="{StaticResource LuxInput}"/>
                    </StackPanel>

                    <!-- Thành phố -->
                    <StackPanel Grid.Column="6" Margin="0,0,12,0">
                        <TextBlock Text="Thành phố" Style="{StaticResource LuxLabel}"/>
                        <TextBox x:Name="txtThanhPho" Style="{StaticResource LuxInput}"/>
                    </StackPanel>

                    <!-- Nút Xóa -->
                    <StackPanel Grid.Column="7" VerticalAlignment="Bottom">
                        <TextBlock Text=" " Style="{StaticResource LuxLabel}"/>
                        <Button Content="✕ Xóa"
                                Height="40"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                FontSize="13"
                                Cursor="Hand"
                                Click="BtnReset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,0">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#F5D77A"/>
                                            <Setter Property="Foreground" Value="#F5D77A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== KẾT QUẢ (Cân đều khi phóng to) ===== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#1A1A1A">

            <StackPanel Margin="40,25,40,40">

                <!-- Số kết quả -->
                <TextBlock x:Name="txtKetQua"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           Margin="0,0,0,20"/>

                <!-- Danh sách card - Căn giữa + dùng hết chiều rộng -->
                <WrapPanel x:Name="wrapList"
                           HorizontalAlignment="Center"
                           Margin="0"/>

                <!-- Thông báo không có kết quả -->
                <StackPanel x:Name="pnlThongBao"
                            HorizontalAlignment="Center"
                            Margin="0,120,0,0"
                            Visibility="Collapsed">

                    <TextBlock Text="🏠" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Không tìm thấy kết quả phù hợp"
                               FontSize="16"
                               Foreground="#CCCCCC"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Vui lòng thử thay đổi bộ lọc tìm kiếm"
                               FontSize="13"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>