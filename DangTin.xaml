<UserControl x:Class="DoAnNhom.DangTin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="40">

            <Border Background="#1A1A1A"
                    CornerRadius="15"
                    Padding="35">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock x:Name="txtTitle"
                               Text="ĐĂNG TIN BẤT ĐỘNG SẢN"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#D4AF37"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Tiêu đề"
                               Foreground="White"/>
                    <TextBox x:Name="txtTieuDe"
                             Margin="0,5,0,15"
                             Height="35"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#333"
                             Padding="10"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Loại tin"
                                       Foreground="White"/>
                            <ComboBox x:Name="cbLoai"
                                      Margin="0,5,0,0"
                                      Background="#2A2A2A"
                                      Foreground="White">
                                <ComboBoxItem Content="MuaBan"/>
                                <ComboBoxItem Content="ChoThue"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Loại BĐS"
                                       Foreground="White"/>
                            <ComboBox x:Name="cbLoaiBDS"
                                      Margin="0,5,0,0"
                                      Background="#2A2A2A"
                                      Foreground="White">
                                <ComboBoxItem Content="NhaO"/>
                                <ComboBoxItem Content="CanHo"/>
                                <ComboBoxItem Content="Dat"/>
                                <ComboBoxItem Content="BietThu"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Giá (VNĐ)"
                                       Foreground="White"/>
                            <TextBox x:Name="txtGia"
                                     Margin="0,5,0,0"
                                     Height="35"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Diện tích (m²)"
                                       Foreground="White"/>
                            <TextBox x:Name="txtDienTich"
                                     Margin="0,5,0,0"
                                     Height="35"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Địa chỉ"
                               Foreground="White"/>
                    <TextBox x:Name="txtDiaChi"
                             Margin="0,5,0,15"
                             Height="35"
                             Background="#2A2A2A"
                             Foreground="White"
                             Padding="10"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Quận/Huyện"
                                       Foreground="White"/>
                            <TextBox x:Name="txtQuanHuyen"
                                     Margin="0,5,0,0"
                                     Height="35"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Thành phố"
                                       Foreground="White"/>
                            <TextBox x:Name="txtThanhPho"
                                     Margin="0,5,0,0"
                                     Height="35"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Mô tả"
                               Foreground="White"/>
                    <TextBox x:Name="txtMoTa"
                             AcceptsReturn="True"
                             Height="100"
                             Margin="0,5,0,15"
                             Background="#2A2A2A"
                             Foreground="White"
                             TextWrapping="Wrap"
                             Padding="10"/>

                    <TextBlock Text="Đường dẫn ảnh (cách nhau dấu ;)"
                               Foreground="White"/>
                    <TextBox x:Name="txtHinhAnh"
                             Margin="0,5,0,25"
                             Height="35"
                             Background="#2A2A2A"
                             Foreground="White"
                             Padding="10"/>

                    <Button x:Name="btnDangTin"
                            Content="ĐĂNG TIN"
                            Height="45"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="Black"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnDangTin_Click">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F6E27A" Offset="0"/>
                                <GradientStop Color="#D4AF37" Offset="0.5"/>
                                <GradientStop Color="#A67C00" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>