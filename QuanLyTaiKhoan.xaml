<Page x:Class="DoAnNhom.QuanLyTaiKhoan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111111">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="QUẢN LÝ TÀI KHOẢN"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#D4AF37"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Danh sách tài khoản trong hệ thống"
                       Foreground="#AAAAAA"
                       FontSize="14"
                       Margin="0,0,0,15"/>

        </StackPanel>

        <!-- ================= DATA GRID ================= -->
        <Border Grid.Row="1"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nút thêm -->
                <Button Content="➕ Thêm tài khoản"
                        Grid.Row="0"
                        Width="180"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,15"
                        Background="#D4AF37"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnThem_Click"/>

                <DataGrid x:Name="dgUser"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Background="#1A1A1A"
                          Foreground="White"
                          GridLinesVisibility="None"
                          RowBackground="#1A1A1A"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          SelectionMode="Single">

                    <DataGrid.Resources>

                        <!-- Header style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#D4AF37"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                        </Style>

                        <!-- Row hover -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Tên đăng nhập"
                                            Binding="{Binding TenDangNhap}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Họ tên"
                                            Binding="{Binding HoTen}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Vai trò"
                                            Binding="{Binding VaiTro}"
                                            Width="*"/>

                        <!-- ACTION -->
                        <DataGridTemplateColumn Header="Hành động"
                                                Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <Button Content="Sửa"
                                                Width="60"
                                                Margin="5"
                                                Background="#D4AF37"
                                                Foreground="Black"
                                                BorderThickness="0"
                                                Click="BtnSua_Click"/>

                                        <Button Content="Xóa"
                                                Width="60"
                                                Margin="5"
                                                Background="#C0392B"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="BtnXoa_Click"/>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>
</Page>