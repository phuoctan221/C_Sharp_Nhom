<Page x:Class="DoAnNhom.Views.TrangChu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  Background="#F5F5F5">

        <StackPanel>

            <TextBlock Text="Tin bất động sản mới nhất"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="40,25,40,15"/>

            <WrapPanel x:Name="panelCards"
                       HorizontalAlignment="Center"
                       Margin="20,10,20,50"/>

            <Grid Margin="0,50,0,0">

                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#111111" Offset="0"/>
                        <GradientStop Color="#1E1E1E" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel Margin="60">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="BẤT ĐỘNG SẢN LUXURY"
                                       Foreground="#D4AF37"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Chuyên mua bán và cho thuê bất động sản cao cấp tại toàn quốc."
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Hotline: 0935 098 48*"
                                       Foreground="#CCCCCC"/>

                            <TextBlock Text="Email: support@luxuryrealestate.vn"
                                       Foreground="#CCCCCC"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,20,0,0">

                                <TextBlock Text="Facebook"
                                           Foreground="White"
                                           Cursor="Hand"
                                           Margin="0,0,20,0"
                                           MouseLeftButtonDown="OpenFacebook">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#D4AF37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Instagram"
                                           Foreground="White"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="OpenInstagram">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#D4AF37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Đội Ngũ "
                                       Foreground="#D4AF37"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Đặng Phước Tấn"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Nguyễn Quang Kiệt"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Nguyễn Đình Phi"
                                       Foreground="White"/>

                        </StackPanel>

                    </Grid>

                    <Border Background="#000000"
                            Margin="0,40,0,0"
                            Padding="10">
                        <TextBlock Text="© 2026 Đặng Phước Tấn - Nguyễn Quang Kiệt - Nguyễn Đình Phi -  Bất Động Sản Luxury"
                                   Foreground="#777777"
                                   HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>

    </ScrollViewer>
</Page>