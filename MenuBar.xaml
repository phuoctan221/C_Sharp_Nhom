<UserControl x:Class="DoAnNhom.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5D77A" Offset="0"/>
            <GradientStop Color="#C9A227" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F5D77A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <Border Padding="14"
            Background="#111111">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="◆"
                           FontSize="22"
                           Foreground="{StaticResource GoldBrush}"
                           Margin="0,0,8,0"/>

                <TextBlock Text="BẤT ĐỘNG SẢN"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Trang chủ"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnTrangChu_Click"/>

                <Button Content="Tìm kiếm"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnTimKiem_Click"/>

                <Button x:Name="btnYeuThich"
                        Content="Yêu thích"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnYeuThich_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="btnDangTin"
                        Content="Đăng tin"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnDangTin_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="btnQuanLyTin"
                        Content="Quản lý tin"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnQuanLyTin_Click"
                        Visibility="Collapsed"/>
                
                <Button x:Name="btnQuanLyTaiKhoan"
                        Content="Quản lý tài khoản"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnQuanLyTaiKhoan_Click"
                        Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">

                <TextBlock x:Name="txtUser"
                           Foreground="#F5D77A"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <Button x:Name="btnDangNhap"
                        Content="Đăng nhập"
                        Padding="16,8"
                        Margin="5,0"
                        FontWeight="Bold"
                        Foreground="Black"
                        Background="{StaticResource GoldBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnDangNhap_Click"/>

                <Button x:Name="btnDangXuat"
                        Content="Đăng xuất"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnDangXuat_Click"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>