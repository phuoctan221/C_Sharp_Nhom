<Page x:Class="DoAnNhom.Views.ChiTiet"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chi Tiết Bất Động Sản"
      Background="#F8F9FA">

    <ScrollViewer>
        <StackPanel Margin="0">

            <Grid Height="460">
                <Border CornerRadius="0,0,25,25"
                        ClipToBounds="True">
                    <Image x:Name="imgHinh"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#99000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Background="#1E40AF"
                        CornerRadius="15"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="20">
                    <TextBlock x:Name="txtLoaiBadge"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </Border>

            </Grid>

            <Grid Margin="40,30,40,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtTieuDe"
                               FontSize="28"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#1F2937"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="txtGia"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"/>

                        <TextBlock x:Name="txtDienTich"
                                   FontSize="18"
                                   Margin="24,6,0,0"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                    <TextBlock x:Name="txtLoai"
                               FontSize="16"
                               Foreground="#4B5563"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="txtDiaChi"
                               FontSize="15.5"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Mô tả chi tiết"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"
                               Foreground="#1F2937"/>

                    <TextBlock x:Name="txtMoTa"
                               FontSize="15.5"
                               TextWrapping="Wrap"
                               LineHeight="26"
                               Foreground="#374151"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Height="280"
                        VerticalAlignment="Top"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Hành động"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,0,0,20"/>

                        <Button x:Name="btnYeuThich"
                                Content="❤️ Lưu vào yêu thích"
                                Height="52"
                                Background="#1E40AF"
                                Foreground="White"
                                FontWeight="Medium"
                                FontSize="15"
                                Click="BtnYeuThich_Click"
                                Margin="0,0,0,12"/>

                        <Button Content="← Quay lại danh sách"
                                Height="52"
                                Background="Transparent"
                                BorderBrush="#1E40AF"
                                BorderThickness="1.5"
                                Foreground="#1E40AF"
                                FontWeight="Medium"
                                FontSize="15"
                                Click="BtnQuayLai_Click"/>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>