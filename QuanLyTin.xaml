<UserControl x:Class="DoAnNhom.QuanLyTin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="QUẢN LÝ TIN ĐĂNG"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#D4AF37"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Danh sách tin của bạn"
                       Foreground="#AAAAAA"
                       FontSize="14"
                       Margin="0,0,0,15"/>
        </StackPanel>

        <!-- ===== DATAGRID ===== -->
        <Border Grid.Row="1"
                Background="#1A1A1A"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="dgTin"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="#1A1A1A"
                      Foreground="White"
                      GridLinesVisibility="None"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#222222"
                      HeadersVisibility="Column"
                      SelectionMode="Single"

                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Hidden">

                <!-- STYLE HEADER -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#D4AF37"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- ẢNH -->
                    <DataGridTemplateColumn Header="Ảnh" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        ClipToBounds="True">
                                    <Image Width="100"
                                           Height="60"
                                           Stretch="Fill"
                                           Source="{Binding HinhAnh}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TIÊU ĐỀ -->
                    <DataGridTextColumn Header="Tiêu đề"
                                        Binding="{Binding TieuDe}"
                                        Width="*"/>

                    <!-- LOẠI -->
                    <DataGridTextColumn Header="Loại"
                                        Binding="{Binding Loai}"
                                        Width="120"/>

                    <!-- GIÁ -->
                    <DataGridTextColumn Header="Giá"
                                        Binding="{Binding Gia, StringFormat={}{0:N0} đ}"
                                        Width="150"/>

                    <!-- DIỆN TÍCH -->
                    <DataGridTextColumn Header="Diện tích"
                                        Binding="{Binding DienTich, StringFormat={}{0} m²}"
                                        Width="120"/>

                    <!-- HÀNH ĐỘNG -->
                    <DataGridTemplateColumn Header="Hành động"
                                            Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="Sửa"
                                            Background="#D4AF37"
                                            Foreground="Black"
                                            Margin="5"
                                            Padding="8,4"
                                            Click="BtnSua_Click"/>

                                    <Button Content="Xóa"
                                            Background="#C0392B"
                                            Foreground="White"
                                            Margin="5"
                                            Padding="8,4"
                                            Click="BtnXoa_Click"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>
</UserControl>